# Copy this file to .env and fill in every value. .env is gitignored.
#
#   cp .env.example .env
#
# Generate each secret with:
#
#   openssl rand -base64 32


# --- Database ------------------------------------------------------------
# Password for the Postgres user the app connects as. Not exposed to the
# network: the db container publishes no host port.
#
# Read once, when the database volume is first created. Changing it later
# does NOT change the existing user's password, so the app will fail to
# connect. To rotate it, either ALTER USER inside the running container, or
# destroy the volume with `docker compose down -v` and start over.
POSTGRES_PASSWORD=


# --- Sessions ------------------------------------------------------------
# Signs the session cookie. Changing it signs everybody out, which is also
# how you revoke every session at once.
SESSION_SECRET=


# --- Sign-in -------------------------------------------------------------
# The single shared password everyone signs in with. There are no user
# accounts yet, so this is the only credential protecting the data.
#
# Pick something long. It is the whole of the authentication.
APP_PASSWORD=


# --- Networking ----------------------------------------------------------
# Loopback port your reverse proxy forwards to. The app binds 127.0.0.1
# only and is never reachable from the network directly.
#
# Change it if something else already holds the port -- a dev server on 3000
# is the usual collision.
HOST_PORT=3000
